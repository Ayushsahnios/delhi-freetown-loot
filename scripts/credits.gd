extends CanvasLayer
## Scrolling credits (issue #211): the v1.0 roll — engine attribution,
## an honest "everything procedural, CC0" art statement, and a walk
## through the systems that make the city. Opens from the title screen
## or the pause menu; the world freezes behind it exactly like the
## pause menu. ESC or the CLOSE button dismisses it, handing focus
## back to the pause menu when it came from there.

const SPEED := 34.0
const GAP := 26.0
const COL_W := 520.0
const GOLD := Color(1.0, 0.78, 0.2)
const INK := Color(0.93, 0.89, 0.76)
const DIM_INK := Color(0.62, 0.56, 0.44)

var _game: Node
var _clip: Control
var _column: VBoxContainer
var _offset := 0.0
var _from_pause := false


func setup(game: Node) -> void:
	_game = game


func _ready() -> void:
	layer = 34
	process_mode = Node.PROCESS_MODE_ALWAYS
	add_to_group("overlay_screen")
	visible = false
	_build()


func open(from_pause: bool) -> void:
	_from_pause = from_pause
	visible = true
	get_tree().paused = true
	_offset = 0.0


func close() -> void:
	visible = false
	if not _from_pause:
		get_tree().paused = false
	elif _game != null and _game._pause != null:
		_game._pause.visible = true


func _process(delta: float) -> void:
	if not visible:
		return
	if Input.is_action_just_pressed("pause"):
		close()
		return
	_offset += delta * SPEED
	var span := _column.get_combined_minimum_size().y + 200.0
	if _offset > span:
		_offset = 0.0
	var x := maxf((_clip.size.x - COL_W) * 0.5, 24.0)
	_column.position = Vector2(x, _clip.size.y + 40.0 - _offset)


func _build() -> void:
	var dim := ColorRect.new()
	dim.color = Color(0.04, 0.03, 0.10, 0.9)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(dim)

	_clip = Control.new()
	_clip.set_anchors_preset(Control.PRESET_FULL_RECT)
	_clip.clip_contents = true
	add_child(_clip)

	_column = VBoxContainer.new()
	_column.add_theme_constant_override("separation", 6)
	_clip.add_child(_column)

	_big("DELHI FREETOWN LOOT", GOLD)
	_line("v%s · a street hustle in an open city" % Game.VERSION, DIM_INK, 14)
	_gap()

	_heading("BUILT WITH")
	_line("Godot Engine 4 · MIT license", INK, 16)
	_line("One engine, zero third-party plugins.", DIM_INK, 13)
	_gap()

	_heading("ART & SOUND")
	_line("Every mesh, texture, animation, sound and tune in this", INK, 15)
	_line("city is generated by code at load time — procedural,", INK, 15)
	_line("original, and free to reuse (CC0).", INK, 15)
	_line("No commercial assets anywhere in the build.", DIM_INK, 13)
	_gap()

	_heading("THE CITY")
	_line("Streets, traffic and crossings", DIM_INK, 14)
	_line("Monsoon, night and the wet pavement after", DIM_INK, 14)
	_line("Metro line, railway and the morning rush", DIM_INK, 14)
	_gap()

	_heading("THE PEOPLE")
	_line("Three legends of the street", DIM_INK, 14)
	_line("Crowds, hawkers and chai stalls", DIM_INK, 14)
	_line("The police who never stop chasing", DIM_INK, 14)
	_gap()

	_heading("THE HUSTLE")
	_line("Fares on the meter, missions on the board", DIM_INK, 14)
	_line("A wallet that remembers every rupee", DIM_INK, 14)
	_line("Rain, radio and the long way home", DIM_INK, 14)
	_gap()

	_heading("FOR")
	_line("everyone who ever crossed this city with", INK, 15)
	_line("eighty rupees and a plan.", INK, 15)
	_gap()
	_gap()
	_big("THANKS FOR PLAYING", GOLD)

	var close_btn := Button.new()
	close_btn.text = "CLOSE"
	close_btn.anchor_left = 1.0
	close_btn.anchor_right = 1.0
	close_btn.offset_left = -150.0
	close_btn.offset_top = 20.0
	close_btn.offset_right = -24.0
	close_btn.offset_bottom = 58.0
	close_btn.pressed.connect(close)
	add_child(close_btn)


func _gap() -> void:
	var pad := Control.new()
	pad.custom_minimum_size = Vector2(0, GAP)
	_column.add_child(pad)


func _big(text: String, color: Color) -> void:
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", 34)
	l.add_theme_color_override("font_color", color)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.custom_minimum_size = Vector2(COL_W, 0)
	_column.add_child(l)


func _heading(text: String) -> void:
	var l := Label.new()
	l.text = "—  %s  —" % text
	l.add_theme_font_size_override("font_size", 18)
	l.add_theme_color_override("font_color", Color(0.98, 0.88, 0.6))
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.custom_minimum_size = Vector2(COL_W, 0)
	_column.add_child(l)


func _line(text: String, color: Color, size: int) -> void:
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.custom_minimum_size = Vector2(COL_W, 0)
	_column.add_child(l)
